<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intentionally no permissions, shared UID, root library, or Manager dependency. -->
    <application
        android:allowBackup="false"
        android:label="ZySU Visibility Probe"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".IsolatedProbeService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":isolated" />
    </application>
</manifest>
