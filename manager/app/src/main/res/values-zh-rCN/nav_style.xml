<resources>
    <string name="nav_style_title">底部导航栏样式</string>
    <string name="nav_style_summary">可选择原有玻璃胶囊、通栏 Material 底栏，或参考 FinaSU 的两种悬浮形式。悬浮形式与页面的悬浮顶栏相配。</string>
    <string name="nav_style_glass">玻璃胶囊</string>
    <string name="nav_style_glass_summary">悬浮玻璃质感，选中状态覆盖图标与文字。</string>
    <string name="nav_style_material">Material 底栏</string>
    <string name="nav_style_material_summary">通栏底栏与配套顶栏，搭配紧凑的图标指示块，颜色跟随当前主题。</string>
    <string name="nav_style_floating_standard">悬浮 · 标准</string>
    <string name="nav_style_floating_standard_summary">紧凑的纯图标胶囊，选中指示块在导航项之间滑动。</string>
    <string name="nav_style_floating_drawer">悬浮 · 抽屉</string>
    <string name="nav_style_floating_drawer_summary">选中的导航项展开显示文字，其他项仅保留图标。</string>
</resources>
